#https://github.com/Olotron/Calculadoa-de-Distancia-para-wardogs/blob/586ff0ea13ab4a90a62771fdf149796e86984a8f/WARDOGS%20-%20Calculadora%20de%20Distancia

@echo off
title WARDOGS - Distance Calculator for Artillery
color 0A

:start
cls
echo ==========================================
echo       WARDOGS - DISTANCE CALCULATOR
echo ==========================================
echo.

REM ==================================================
REM LOAD SAVED POSITION
REM ==================================================

if exist "my_position.txt" (
    set /p "coord1="<"my_position.txt"
    echo Saved position: %coord1%
    echo.
) else (
    echo Paste your coordinate in this format:
    echo   x93.41, y64.85
    echo.
    set /p "coord1=Your coordinate: "

    echo.
    set /p "save=Do you want to save this position? [Y/N]: "

    if /I "%save%"=="Y" (
        echo %coord1%>"my_position.txt"
        echo.
        echo Position saved!
    )
)

:calculate
echo.
echo ------------------------------------------
set "coord2="
set /p "coord2=Enemy coordinate: "

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$a=$env:coord1; $b=$env:coord2; try { $m1=[regex]::Match($a,'x\s*(-?\d+(?:\.\d+)?)\s*,\s*y\s*(-?\d+(?:\.\d+)?)'); $m2=[regex]::Match($b,'x\s*(-?\d+(?:\.\d+)?)\s*,\s*y\s*(-?\d+(?:\.\d+)?)'); if(-not $m1.Success -or -not $m2.Success){throw 'Invalid format'}; $x1=[double]::Parse($m1.Groups[1].Value,[Globalization.CultureInfo]::InvariantCulture); $y1=[double]::Parse($m1.Groups[2].Value,[Globalization.CultureInfo]::InvariantCulture); $x2=[double]::Parse($m2.Groups[1].Value,[Globalization.CultureInfo]::InvariantCulture); $y2=[double]::Parse($m2.Groups[2].Value,[Globalization.CultureInfo]::InvariantCulture); $dx=$x2-$x1; $dy=$y2-$y1; $d=[math]::Sqrt($dx*$dx+$dy*$dy); $meters=$d*100; $km=$d/10; Write-Host ''; Write-Host '==========================================' -ForegroundColor Green; Write-Host (' DX = {0:N2}' -f $dx); Write-Host (' DY = {0:N2}' -f $dy); Write-Host (' DISTANCE = {0:N2} units - MORTAR' -f $d) -ForegroundColor Yellow; Write-Host ('            = {0:N0} meters - SPH-2 ARTILLERY HOWITZER' -f $meters) -ForegroundColor Yellow; Write-Host ('            = {0:N3} km' -f $km) -ForegroundColor Yellow; Write-Host '==========================================' -ForegroundColor Green } catch { Write-Host ''; Write-Host 'ERROR: use exactly this format x93.41, y64.85' -ForegroundColor Red; Write-Host '' }"

echo.
set "change="
set /p "change=Do you want to change your position? [Y/N]: "

if /I "%change%"=="Y" goto newposition

goto calculate

:newposition
cls
echo ==========================================
echo           NEW POSITION
echo ==========================================
echo.
echo Paste your new coordinate in this format:
echo   x93.41, y64.85
echo.

set "coord1="
set /p "coord1=Your new coordinate: "

echo %coord1%>"my_position.txt"

echo.
echo Position updated and saved!
timeout /t 1 >nul
goto calculate
