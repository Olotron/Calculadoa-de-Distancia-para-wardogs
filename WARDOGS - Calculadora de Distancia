#https://github.com/Olotron/Calculadoa-de-Distancia-para-wardogs/blob/586ff0ea13ab4a90a62771fdf149796e86984a8f/WARDOGS%20-%20Calculadora%20de%20Distancia

@echo off
title WARDOGS - Calculadora de Distancia para artilharia
color 0A

:inicio
cls
echo ==========================================
echo       WARDOGS - CALCULADORA DE DISTANCIA
echo ==========================================
echo.

REM ==================================================
REM CARREGA SUA POSICAO SALVA
REM ==================================================

if exist "minha_posicao.txt" (
    set /p "coord1="<"minha_posicao.txt"
    echo Sua posicao salva: %coord1%
    echo.
) else (
    echo Cole sua coordenada neste formato:
    echo   x93.41, y64.85
    echo.
    set /p "coord1=Sua coordenada: "

    echo.
    set /p "salvar=Deseja salvar esta posicao? [S/N]: "

    if /I "%salvar%"=="S" (
        echo %coord1%>"minha_posicao.txt"
        echo.
        echo Posicao salva!
    )
)

:calcular
echo.
echo ------------------------------------------
set "coord2="
set /p "coord2=Coordenada inimiga: "

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$a=$env:coord1; $b=$env:coord2; try { $m1=[regex]::Match($a,'x\s*(-?\d+(?:\.\d+)?)\s*,\s*y\s*(-?\d+(?:\.\d+)?)'); $m2=[regex]::Match($b,'x\s*(-?\d+(?:\.\d+)?)\s*,\s*y\s*(-?\d+(?:\.\d+)?)'); if(-not $m1.Success -or -not $m2.Success){throw 'Formato invalido'}; $x1=[double]::Parse($m1.Groups[1].Value,[Globalization.CultureInfo]::InvariantCulture); $y1=[double]::Parse($m1.Groups[2].Value,[Globalization.CultureInfo]::InvariantCulture); $x2=[double]::Parse($m2.Groups[1].Value,[Globalization.CultureInfo]::InvariantCulture); $y2=[double]::Parse($m2.Groups[2].Value,[Globalization.CultureInfo]::InvariantCulture); $dx=$x2-$x1; $dy=$y2-$y1; $d=[math]::Sqrt($dx*$dx+$dy*$dy); $metros=$d*100; $km=$d/10; Write-Host ''; Write-Host '==========================================' -ForegroundColor Green; Write-Host (' DX = {0:N2}' -f $dx); Write-Host (' DY = {0:N2}' -f $dy); Write-Host (' DISTANCIA = {0:N2} unidades' -f $d) -ForegroundColor Yellow; Write-Host ('            = {0:N0} metros' -f $metros) -ForegroundColor Yellow; Write-Host ('            = {0:N3} km' -f $km) -ForegroundColor Yellow; Write-Host '==========================================' -ForegroundColor Green } catch { Write-Host ''; Write-Host 'ERRO: use exatamente o formato x93.41, y64.85' -ForegroundColor Red; Write-Host '' }"

echo.
set "mudar="
set /p "mudar=Deseja mudar sua posicao? [S/N]: "

if /I "%mudar%"=="S" goto mudarpos

goto calcular

:mudarpos
cls
echo ==========================================
echo          NOVA POSICAO
echo ==========================================
echo.
echo Cole a nova coordenada neste formato:
echo   x93.41, y64.85
echo.

set "coord1="
set /p "coord1=Sua nova coordenada: "

echo %coord1%>"minha_posicao.txt"

echo.
echo Posicao atualizada e salva!
timeout /t 1 >nul
goto calcular
